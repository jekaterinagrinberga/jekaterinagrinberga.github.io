---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

const home = await getEntry('pages', 'home');
const { heroName, tagline, blogIntro, aboutText } = home.data;
const blogIntroParagraphs = blogIntro.trim().split(/\n\s*\n/);
const aboutParagraphs = aboutText.trim().split(/\n\s*\n/);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Jekaterina Grinberga',
  description: 'I help growing companies turn sustainability into business strategy. I write and speak about supply chain transparency, ESG and what actually works.',
  url: 'https://jekaterinagrinberga.com',
  image: 'https://jekaterinagrinberga.com/images/hero.jpg',
  sameAs: ['https://www.linkedin.com/in/jekaterina-grinberga/'],
};
---

<Layout
  title="Jekaterina Grinberga – Corporate Sustainability"
  description="Jekaterina Grinberga is an advocate for sustainable living, writing on corporate sustainability, ESG and climate topics."
  image="/images/hero.jpg"
  structuredData={structuredData}
>
  <section class="hero wrap">
    <div class="hero-photo">
      <img
        src="/images/hero.jpg"
        alt="Jekaterina Grinberga"
        width="819"
        height="1024"
      />
    </div>
    <div class="hero-text">
      <h1>{heroName}</h1>
      <p class="tagline">{tagline}</p>
    </div>
  </section>

  <section class="blog-teaser">
    <div class="wrap blog-teaser-inner">
      <div class="big-letters" aria-hidden="true">
        <span>B</span><span>L</span><span>O</span><span>G</span>
      </div>
      <div class="blog-teaser-content">
        <img
          src="/images/blog-teaser.jpg"
          alt=""
          loading="lazy"
        />
        {blogIntroParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        <a class="btn" href="/blog/">read the blog ⟶</a>
      </div>
    </div>
  </section>

  <section class="about wrap">
    <div class="about-photo">
      <img
        src="/images/about.jpg"
        alt={heroName}
        width="664"
        height="1024"
        loading="lazy"
      />
    </div>
    <div class="about-content">
      <h2>about me</h2>
      {aboutParagraphs.map((paragraph) => <p>{paragraph}</p>)}
      <a class="btn" href="https://www.linkedin.com/in/jekaterina-grinberga/" target="_blank" rel="noopener noreferrer">
        LinkedIn ⟶
      </a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 2fr;
    align-items: center;
    gap: 48px;
    padding: 64px 24px;
  }

  .hero-photo img {
    border-radius: 4px;
    width: 100%;
    height: auto;
  }

  .hero-text h1 {
    font-size: clamp(40px, 6vw, 75px);
    letter-spacing: 4px;
    margin-bottom: 0.3em;
  }

  .tagline {
    font-size: 20px;
    margin: 0;
    color: var(--color-muted);
  }

  .blog-teaser {
    padding: 48px 0;
  }

  .blog-teaser-inner {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 48px;
    align-items: start;
  }

  .big-letters {
    display: flex;
    flex-direction: column;
    font-family: var(--font-heading);
    font-size: clamp(48px, 8vw, 96px);
    line-height: 0.95;
    letter-spacing: 2px;
  }

  .blog-teaser-content img {
    width: 100%;
    max-width: 480px;
    height: auto;
    border-radius: 4px;
    margin-bottom: 24px;
  }

  .blog-teaser-content p {
    max-width: 60ch;
  }

  .about {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 48px;
    align-items: center;
    background: var(--color-bg-tint);
    padding: 64px 24px;
    border-radius: 4px;
  }

  .about-photo img {
    border-radius: 4px;
    width: 100%;
    height: auto;
  }

  .about-content h2 {
    font-size: clamp(40px, 6vw, 75px);
  }

  .about-content p {
    max-width: 55ch;
    margin-bottom: 24px;
  }

  @media (max-width: 720px) {
    .hero,
    .blog-teaser-inner,
    .about {
      grid-template-columns: 1fr;
    }

    .big-letters {
      flex-direction: row;
      font-size: 48px;
    }
  }
</style>
