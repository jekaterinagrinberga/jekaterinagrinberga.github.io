---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { getFirstImage } from '../lib/postImage';
import { addFigures } from '../lib/postFigures';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
// Post HTML with pictures turned into floating figures with captions
const postHtml = post.rendered?.html ? addFigures(post.rendered.html) : null;

function formatDate(iso: string) {
  const d = new Date(iso);
  return d.toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric' });
}

const ogImage = post.data.featuredImage ?? getFirstImage(post.body ?? '') ?? '/images/hero.jpg';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.excerpt,
  datePublished: post.data.date,
  dateModified: post.data.date,
  image: new URL(ogImage, 'https://jekaterinagrinberga.com').toString(),
  url: `https://jekaterinagrinberga.com/${post.id}/`,
  mainEntityOfPage: `https://jekaterinagrinberga.com/${post.id}/`,
  author: {
    '@type': 'Person',
    name: 'Jekaterina Grinberga',
    url: 'https://jekaterinagrinberga.com',
  },
  publisher: {
    '@type': 'Person',
    name: 'Jekaterina Grinberga',
  },
};
---

<Layout
  title={`${post.data.title} – Jekaterina Grinberga`}
  description={post.data.excerpt}
  image={ogImage}
  type="article"
  publishedTime={post.data.date}
  structuredData={structuredData}
>
  <article class="wrap post">
    <h1>{post.data.title}</h1>
    <p class="date">{formatDate(post.data.date)}</p>
    <div class="content">
      {postHtml ? <Fragment set:html={postHtml} /> : <Content />}
    </div>
    <a class="back" href="/blog/">← Back to blog</a>
  </article>
</Layout>

<style>
  /* Full page width, lined up with the header menu */
  .post {
    padding: 48px 24px 80px;
  }

  h1 {
    font-size: clamp(16px, 2.5vw, 28px);
  }

  .date {
    color: #999;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 32px;
  }

  /* Same outline button as "Get in touch" on the homepage */
  .back {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    margin-top: 48px;
    padding: 0 24px;
    border: 1px solid var(--color-text);
    border-radius: 999px;
    background: transparent;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 400;
    text-decoration: none;
    transition: transform 0.15s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .back:hover,
  .back:focus-visible {
    transform: translateY(-1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .back {
      transition: none;
    }

    .back:hover,
    .back:focus-visible {
      transform: none;
    }
  }

  .content :global(p) {
    margin: 0 0 1.4em;
  }

  /* Same text style as the About me section on the homepage */
  .content :global(p),
  .content :global(li) {
    font-family: var(--font-body);
    font-size: 18px;
    color: var(--color-muted);
    text-align: justify;
  }

  /* Pictures float left or right with text wrapping around them.
     Same width as the photos on the homepage (one third of the page row),
     keeping each picture's own proportions */
  .content :global(.post-figure) {
    width: min(100%, calc((min(100vw, var(--max-width)) - 96px) / 3));
    margin: 0.4em 0 1.4em;
  }

  .content :global(.float-left) {
    float: left;
    clear: left;
    margin-right: 32px;
  }

  .content :global(.float-right) {
    float: right;
    clear: right;
    margin-left: 32px;
  }

  .content :global(.post-figure img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
  }

  .content :global(figcaption) {
    margin-top: 8px;
    font-size: 14px;
    line-height: 1.4;
    color: var(--color-muted);
    text-align: center;
  }

  /* Nothing floats past the end of the post */
  .content::after {
    content: '';
    display: block;
    clear: both;
  }

  .content :global(h2),
  .content :global(h3) {
    margin-top: 1.6em;
  }

  /* Links look like the surrounding text, just underlined */
  .content :global(a) {
    color: inherit;
    text-decoration: underline;
  }

  /* Links in lists, e.g. the reading lists at the end of posts */
  .content :global(li a) {
    font-weight: 700;
  }

  .content :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding-left: 20px;
    margin: 1.6em 0;
    font-style: italic;
    color: var(--color-muted);
  }

  @media (max-width: 720px) {
    .content :global(p),
    .content :global(li) {
      font-size: 16px;
      text-align: left;
    }

    .back {
      font-size: 18px;
    }

    /* On phones pictures sit centred between paragraphs, 240px wide like the homepage */
    .content :global(.post-figure) {
      float: none;
      width: min(100%, 240px);
      margin: 1.4em auto;
    }
  }
</style>
