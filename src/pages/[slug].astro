---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { getFirstImage } from '../lib/postImage';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(iso: string) {
  const d = new Date(iso);
  return d.toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric' });
}

const ogImage = post.data.featuredImage ?? getFirstImage(post.body ?? '') ?? '/images/hero.jpg';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.excerpt,
  datePublished: post.data.date,
  dateModified: post.data.date,
  image: new URL(ogImage, 'https://jekaterinagrinberga.com').toString(),
  url: `https://jekaterinagrinberga.com/${post.id}/`,
  mainEntityOfPage: `https://jekaterinagrinberga.com/${post.id}/`,
  author: {
    '@type': 'Person',
    name: 'Jekaterina Grinberga',
    url: 'https://jekaterinagrinberga.com',
  },
  publisher: {
    '@type': 'Person',
    name: 'Jekaterina Grinberga',
  },
};
---

<Layout
  title={`${post.data.title} – Jekaterina Grinberga`}
  description={post.data.excerpt}
  image={ogImage}
  type="article"
  publishedTime={post.data.date}
  structuredData={structuredData}
>
  <article class="wrap post">
    <h1>{post.data.title}</h1>
    <p class="date">{formatDate(post.data.date)}</p>
    <div class="content">
      <Content />
    </div>
    <a class="btn back" href="/blog/">⟵ back to blog</a>
  </article>
</Layout>

<style>
  .post {
    padding: 48px 0 80px;
    max-width: 780px;
  }

  h1 {
    font-size: clamp(32px, 5vw, 56px);
  }

  .date {
    color: #999;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 32px;
  }

  .back {
    margin-top: 48px;
  }

  .content :global(p) {
    margin: 0 0 1.4em;
  }

  .content :global(img) {
    border-radius: 4px;
    height: auto;
    display: block;
    margin: 2em auto;
  }

  .content :global(p:has(img)) {
    text-align: center;
  }

  .content :global(h2),
  .content :global(h3) {
    margin-top: 1.6em;
  }

  .content :global(a) {
    color: var(--color-accent);
  }

  .content :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding-left: 20px;
    margin: 1.6em 0;
    font-style: italic;
    color: var(--color-muted);
  }

</style>
