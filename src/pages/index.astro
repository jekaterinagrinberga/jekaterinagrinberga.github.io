---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

const home = await getEntry('pages', 'home');
const { heroName, tagline, blogIntro, aboutText } = home.data;
const blogIntroParagraphs = blogIntro.trim().split(/\n\s*\n/);
const aboutParagraphs = aboutText.trim().split(/\n\s*\n/);

// Turn **text** in home.md into bold, escaping everything else
const withBold = (text: string) =>
  text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Jekaterina Grinberga',
  description: 'I help growing companies turn sustainability into business strategy. I write and speak about supply chain transparency, ESG and what actually works.',
  url: 'https://jekaterinagrinberga.com',
  image: 'https://jekaterinagrinberga.com/images/hero.jpg',
  sameAs: ['https://www.linkedin.com/in/jekaterina-grinberga/'],
};
---

<Layout
  title="Jekaterina Grinberga – Corporate Sustainability"
  description="Jekaterina Grinberga is an advocate for sustainable living, writing on corporate sustainability, ESG and climate topics."
  image="/images/hero.jpg"
  structuredData={structuredData}
>
  <section class="hero wrap">
    <div class="hero-photo">
      <img
        src="/images/hero.jpg"
        alt="Jekaterina Grinberga"
        width="819"
        height="1024"
      />
    </div>
    <div class="hero-text">
      <h1>{heroName}</h1>
      <p class="tagline" set:html={withBold(tagline)} />
      <div class="hero-actions">
        <a class="contact-btn" href="mailto:jekaterina.grinberga@gmail.com">Get in touch →</a>
      </div>
    </div>
  </section>

  <section class="about wrap">
    <div class="about-content">
      <h2>about me</h2>
      {aboutParagraphs.map((paragraph) => <p set:html={withBold(paragraph)} />)}
      <a class="contact-btn" href="https://www.linkedin.com/in/jekaterina-grinberga/" target="_blank" rel="noopener noreferrer">LinkedIn →</a>
    </div>
  </section>

  <section class="blog-teaser wrap">
    <div class="blog-teaser-inner">
      <div class="blog-teaser-content">
        <h2>blog</h2>
        {blogIntroParagraphs.map((paragraph) => <p set:html={withBold(paragraph)} />)}
        <a class="contact-btn" href="/blog/">Read the blog →</a>
      </div>
      <div class="blog-teaser-photo">
        <img
          src="/images/about.jpg"
          alt={heroName}
          width="724"
          height="1086"
          loading="lazy"
        />
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 2fr;
    align-items: center;
    gap: 48px;
    padding: 64px 24px 24px;
  }

  .hero-photo img {
    border-radius: 4px;
    width: 100%;
    height: auto;
  }

  .hero-text {
    container-type: inline-size;
  }

  .hero-text h1 {
    /* Scale with the text column so the name always stays on one line */
    font-size: min(62px, 9.8cqi);
    letter-spacing: 0.06em;
    white-space: nowrap;
    margin-bottom: 0.3em;
  }

  /* Body text in all three sections matches the intro under the name */
  .tagline,
  .about-content p,
  .blog-teaser-content p {
    font-family: var(--font-body);
    font-size: 20px;
    color: var(--color-muted);
    text-align: justify;
  }

  .tagline {
    margin: 0;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    margin-top: 32px;
  }

  .contact-btn {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 0 24px;
    border: 1px solid var(--color-text);
    border-radius: 999px;
    background: transparent;
    color: var(--color-text);
    /* Same font as the intro text above it */
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 400;
    text-decoration: none;
    transition: transform 0.15s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Lift slightly on hover instead of changing colour */
  .contact-btn:hover,
  .contact-btn:focus-visible {
    transform: translateY(-1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-btn {
      transition: none;
    }

    .contact-btn:hover,
    .contact-btn:focus-visible {
      transform: none;
    }
  }


  .tagline :global(strong),
  .about-content p :global(strong),
  .blog-teaser-content p :global(strong) {
    font-weight: 700;
    color: var(--color-text);
  }

  .about-content p,
  .blog-teaser-content p {
    font-size: 18px;
  }

  .blog-teaser {
    /* Same side padding as the hero so the photo column matches the top photo */
    padding: 24px;
  }

  .blog-teaser-inner {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 48px;
    align-items: center;
  }

  .blog-teaser-content p {
    margin-bottom: 24px;
  }

  .blog-teaser-photo img {
    width: 100%;
    aspect-ratio: 819 / 1024;
    height: auto;
    object-fit: cover;
    object-position: center 35%;
    border-radius: 4px;
  }

  .about {
    background: #eef7ec;
    padding: 40px 24px;
    border-radius: 4px;
  }

  .blog-teaser h2,
  .about-content h2 {
    /* Kept smaller than the name at the top (max 62px) */
    font-size: clamp(26px, 3.6vw, 44px);
  }

  .about-content p {
    margin-bottom: 24px;
  }

  @media (max-width: 720px) {
    .hero,
    .blog-teaser-inner {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .hero {
      padding-top: 32px;
    }

    /* Smaller, centred photos so the name and text show up sooner */
    .hero-photo img,
    .blog-teaser-photo img {
      width: min(100%, 240px);
      margin: 0 auto;
    }

    /* Justified text leaves big gaps between words on narrow screens */
    .tagline,
    .about-content p,
    .blog-teaser-content p {
      text-align: left;
    }

    .tagline,
    .contact-btn {
      font-size: 18px;
    }

    .about-content p,
    .blog-teaser-content p {
      font-size: 16px;
    }
  }
</style>
